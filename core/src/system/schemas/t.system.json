{
  "$id": "t.system",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "System actions — type discovery and prefab deployment",
  "properties": {},
  "methods": {
    "catalog": {
      "description": "List all registered types with properties and actions",
      "kind": "read",
      "arguments": []
    },
    "search_types": {
      "description": "Search types by keyword across names, properties, and actions",
      "kind": "read",
      "arguments": [
        {
          "name": "data",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "title": "Search keyword"
            }
          },
          "required": [
            "query"
          ]
        }
      ]
    },
    "describe_type": {
      "description": "Full type schema with properties, actions, args, and cross-references",
      "kind": "read",
      "arguments": [
        {
          "name": "data",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "title": "Type name, e.g. \"cafe.contact\""
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "deploy_prefab": {
      "description": "Deploy module prefab template to target path. Idempotent",
      "arguments": [
        {
          "name": "data",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "title": "Prefab source path, e.g. /sys/mods/cafe/prefabs/default"
            },
            "target": {
              "type": "string",
              "title": "Target path where nodes will be created"
            },
            "allowAbsolute": {
              "type": "boolean",
              "title": "Allow writing outside target"
            }
          },
          "required": [
            "source",
            "target"
          ]
        }
      ]
    }
  }
}
