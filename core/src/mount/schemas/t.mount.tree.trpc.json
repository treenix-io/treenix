{
  "$id": "t.mount.tree.trpc",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "default": ""
    },
    "path": {
      "type": "string",
      "default": "/"
    },
    "token": {
      "type": "string",
      "default": ""
    },
    "allowPrivate": {
      "type": "boolean",
      "title": "Allow a loopback/private/link-local host (local peers, tests). Off by",
      "description": "default: guards admin typos against internal endpoints (F3).",
      "default": false
    }
  },
  "required": [
    "url",
    "path",
    "token",
    "allowPrivate"
  ]
}
