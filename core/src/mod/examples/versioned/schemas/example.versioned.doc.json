{
  "$id": "example.versioned.doc",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Versioned document — demonstrates per-type schema migrations",
  "version": 2,
  "properties": {
    "body": {
      "type": "string",
      "default": ""
    },
    "words": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "body",
    "words"
  ]
}
