{
  "name": "@treenx/core",
  "version": "3.0.19",
  "description": "Composable typed tree engine — three primitives, everything else composes. Nodes, components, contexts.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-MIT",
  "author": "Treenix <hello@treenix.ai> (https://treenix.ai)",
  "homepage": "https://github.com/treenix-io/treenix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treenix-io/treenix.git"
  },
  "keywords": [
    "treenix",
    "tree",
    "composable",
    "typed",
    "ecs",
    "node",
    "component",
    "context",
    "mcp",
    "ai-native"
  ],
  "imports": {
    "#chain": {
      "development": "./src/lab/tree-chain-support.ts",
      "default": "./dist/lab/tree-chain-support.js"
    },
    "#*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./comp": {
      "development": "./src/comp.ts",
      "types": "./dist/comp.d.ts",
      "default": "./dist/comp.js"
    },
    "./comp/validate": {
      "development": "./src/comp/validate.ts",
      "types": "./dist/comp/validate.d.ts",
      "default": "./dist/comp/validate.js"
    },
    "./tree": {
      "development": "./src/tree.ts",
      "types": "./dist/tree.d.ts",
      "default": "./dist/tree.js"
    },
    "./tree/branch": {
      "development": "./src/tree/branch.ts",
      "types": "./dist/tree/branch.d.ts",
      "default": "./dist/tree/branch.js"
    },
    "./tree/migrate-component-namespace": {
      "development": "./src/tree/migrate-component-namespace.ts",
      "types": "./dist/tree/migrate-component-namespace.d.ts",
      "default": "./dist/tree/migrate-component-namespace.js"
    },
    "./tree/trash-exempt": {
      "development": "./src/tree/trash-exempt.ts",
      "types": "./dist/tree/trash-exempt.d.ts",
      "default": "./dist/tree/trash-exempt.js"
    },
    "./tree/cache": {
      "development": "./src/tree/cache.ts",
      "types": "./dist/tree/cache.d.ts",
      "default": "./dist/tree/cache.js"
    },
    "./tree/inflight": {
      "development": "./src/tree/inflight.ts",
      "types": "./dist/tree/inflight.d.ts",
      "default": "./dist/tree/inflight.js"
    },
    "./tree/mimefs": {
      "development": "./src/tree/mimefs.ts",
      "types": "./dist/tree/mimefs.d.ts",
      "default": "./dist/tree/mimefs.js"
