    },
    "./contexts/text": {
      "development": "./src/contexts/text.ts",
      "types": "./dist/contexts/text.d.ts",
      "default": "./dist/contexts/text.js"
    },
    "./server/actions": {
      "development": "./src/server/actions.ts",
      "types": "./dist/server/actions.d.ts",
      "default": "./dist/server/actions.js"
    },
    "./server/jobs": {
      "development": "./src/server/jobs.ts",
      "types": "./dist/server/jobs.d.ts",
      "default": "./dist/server/jobs.js"
    },
    "./server/server": {
      "development": "./src/server/server.ts",
      "types": "./dist/server/server.d.ts",
      "default": "./dist/server/server.js"
    },
    "./server/client": {
      "development": "./src/server/client.ts",
      "types": "./dist/server/client.d.ts",
      "default": "./dist/server/client.js"
    },
    "./server/prefab": {
      "development": "./src/server/prefab.ts",
      "types": "./dist/server/prefab.d.ts",
      "default": "./dist/server/prefab.js"
