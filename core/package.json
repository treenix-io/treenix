    "./server/readonly-tree": {
      "development": "./src/server/readonly-tree.ts",
      "types": "./dist/server/readonly-tree.d.ts",
      "default": "./dist/server/readonly-tree.js"
    },
    "./util/safe-timers": {
      "development": "./src/util/safe-timers.ts",
      "types": "./dist/util/safe-timers.d.ts",
      "default": "./dist/util/safe-timers.js"
    },
    "./util/debounced-write": {
      "development": "./src/util/debounced-write.ts",
      "types": "./dist/util/debounced-write.d.ts",
      "default": "./dist/util/debounced-write.js"
    },
    "./util/yaml": {
      "development": "./src/util/yaml.ts",
      "types": "./dist/util/yaml.d.ts",
      "default": "./dist/util/yaml.js"
    },
    "./vite-plugin": {
      "development": "./src/vite-plugin.ts",
