      "default": "./dist/mod.js"
    },
    "./mount": {
      "development": "./src/mount.ts",
      "types": "./dist/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./kernel": {
      "development": "./src/kernel/index.ts",
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./errors": {
      "development": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./glob": {
      "development": "./src/glob.ts",
      "types": "./dist/glob.d.ts",
      "default": "./dist/glob.js"
    },
    "./uri": {
      "development": "./src/uri.ts",
      "types": "./dist/uri.d.ts",
      "default": "./dist/uri.js"
    },
    "./log": {
      "development": "./src/log.ts",
      "types": "./dist/log.d.ts",
      "default": "./dist/log.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./schema/types": {
      "development": "./src/schema/types.ts",
      "types": "./dist/schema/types.d.ts",
      "default": "./dist/schema/types.js"
    },
    "./schema/load": {
      "development": "./src/schema/load.ts",
      "types": "./dist/schema/load.d.ts",
      "default": "./dist/schema/load.js"
    },
    "./schema/catalog": {
      "development": "./src/schema/catalog.ts",
      "types": "./dist/schema/catalog.d.ts",
      "default": "./dist/schema/catalog.js"
    },
    "./security": {
      "development": "./src/security.ts",
      "types": "./dist/security.d.ts",
      "default": "./dist/security.js"
    },
    "./security/projector": {
      "development": "./src/security/projector.ts",
      "types": "./dist/security/projector.d.ts",
      "default": "./dist/security/projector.js"
