      "types": "./dist/mods/autostart/service.d.ts",
      "default": "./dist/mods/autostart/service.js"
    }
  },
  "treenix": {
    "clients": "./src/mods/clients.ts",
    "servers": "./src/mods/servers.ts"
  },
  "bin": {
    "fix-hash-imports": "./bin/fix-hash-imports.mjs",
    "treenix": "./bin/treenix.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && fix-hash-imports",
    "prepack": "npm run build",
    "test": "tsx --conditions development --test 'src/**/*.test.ts'",
    "dev:server": "npm run schema && tsx --conditions development --watch src/server/main.ts ../root.json",
    "schema": "tsx src/schema/extract-schemas-oxc.ts src ../mods ../packages ../../mods"
  },
  "dependencies": {
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "fast-json-patch": "^3.1.1",
    "immer": "^11.1.4",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@orama/orama": "^3.1.18"
  },
  "peerDependencies": {
    "quickjs-emscripten": "^0.32.0",
    "tsx": "^4.21.0"
  },
  "peerDependenciesMeta": {
    "quickjs-emscripten": {
      "optional": true
    },
    "tsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxc-parser": "^0.128.0",
    "quickjs-emscripten": "^0.32.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
