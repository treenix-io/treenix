{
  "$id": "board.column",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Kanban column — label + color. Sort order lives in the `#order` component.",
  "properties": {
    "label": {
      "type": "string",
      "default": ""
    },
    "color": {
      "type": "string",
      "default": "border-border"
    }
  },
  "required": [
    "label",
    "color"
  ]
}
